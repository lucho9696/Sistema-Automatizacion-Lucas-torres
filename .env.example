APP_NAME="Sistema Comercial"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_AR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ventas
DB_USERNAME=app
DB_PASSWORD=


SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Negocio (ver docs/adr/0001-arquitectura-hito-1.md) ---
# Moneda base de reporte (ISO 4217). Las operaciones guardan su moneda original y su cotización.
BUSINESS_BASE_CURRENCY=ARS
# Monedas operativas aceptadas, separadas por coma.
BUSINESS_CURRENCIES=ARS,USD
# Zona horaria para presentar fechas (el backend guarda en UTC).
BUSINESS_DISPLAY_TIMEZONE=America/Argentina/Cordoba
# Permitir stock negativo (NO recomendado). Por defecto false.
INVENTORY_ALLOW_NEGATIVE_STOCK=false
# Método de distribución de costos de importación: value (proporcional al valor de compra) | quantity
PURCHASE_ALLOCATION_METHOD=value

# Usuario administrador inicial (solo lo usa `php artisan app:create-admin` si no se pasan opciones)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Integraciones del Hito 2 (ver docs/adr/0002-crm-y-radar-hito-2.md) ---
# Radar de tendencias: demo (datos ficticios marcados [DEMO]) | mercadolibre (API oficial de Trends, requiere OAuth)
TRENDS_PROVIDER=demo
TRENDS_SITE=MLA
# App creada en https://developers.mercadolibre.com.ar (no commitear valores reales)
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# Debe coincidir exactamente con la URL de redirección registrada en la app de Mercado Libre
ML_REDIRECT_URI=https://tu-dominio/integraciones/mercadolibre/callback
# Opcionales (defaults correctos para Argentina)
# ML_API_BASE_URL=https://api.mercadolibre.com
# ML_AUTH_URL=https://auth.mercadolibre.com.ar/authorization

# Google Places (Text Search, API PAGA). off | demo | live. Apagado por defecto.
GOOGLE_PLACES_MODE=off
GOOGLE_PLACES_API_KEY=
# Campos pedidos (definen el SKU facturado). Pedir solo lo necesario.
GOOGLE_PLACES_FIELD_MASK=places.id,places.displayName,places.formattedAddress,places.nationalPhoneNumber,places.websiteUri,places.googleMapsUri
# Tope de solicitudes por mes calendario contadas por el sistema. 0 = bloqueado.
GOOGLE_PLACES_MONTHLY_REQUEST_LIMIT=0

# --- WhatsApp (Hito 3, ver docs/adr/0003-whatsapp-hito-3.md) ---
# simulado (por defecto: nada sale del sistema) | cloud (WhatsApp Business Platform Cloud API oficial)
WHATSAPP_MODE=simulado
# Datos de la app de Meta del negocio (no commitear valores reales)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
# Cadena aleatoria que se repite en la configuración del webhook en Meta
WHATSAPP_VERIFY_TOKEN=
# Opcionales
# WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_QUOTE_VALID_HOURS=24
WHATSAPP_RETENTION_DAYS=365
